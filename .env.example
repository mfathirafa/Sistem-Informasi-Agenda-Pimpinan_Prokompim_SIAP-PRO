# Connection string database PostgreSQL kamu (contoh: dari Neon.tech, bisa juga Supabase/Railway)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Kunci rahasia untuk menandatangani sesi login - ganti dengan teks acak panjang (minimal 32 karakter)
# Bisa generate cepat di https://generate-secret.vercel.app/32 atau perintah: openssl rand -base64 32
AUTH_SECRET="ganti-dengan-teks-acak-minimal-32-karakter"
