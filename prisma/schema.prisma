generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  STAFF
  ATASAN
}

enum StatusSambutan {
  SUDAH
  BELUM
}

enum StatusKegiatan {
  ACARA_MASUK
  MENUNGGU_PENUGASAN
  KEGIATAN_SELESAI
  SPJ_SELESAI
}

enum StatusPublikasi {
  BELUM_DIRILIS
  TIDAK_DIRILIS
  DIRILIS
}

enum JenisDokumen {
  SURAT_TUGAS
  SURAT_UNDANGAN
  NASKAH_SAMBUTAN
  DOKUMENTASI_FOTO
  DOKUMENTASI_VIDEO
  BERKAS_SPJ
  LAPORAN_AKHIR
}

enum StatusDokumen {
  BELUM_UPLOAD
  SUDAH_UPLOAD
  PERLU_REVISI
}

enum JenisPenugasan {
  LEMBUR
  SPPD
  KEGIATAN
}

enum Entity {
  KEGIATAN
  DOKUMEN
  PETUGAS
  LEADING_SECTOR
  USER
}

enum ActionLog {
  CREATE
  UPDATE
  DELETE
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  nama      String
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())
  activityLog ActivityLog[]

  @@map("users")
}

enum KategoriPetugas {
  PROTOKOL
  LIPUTAN
}

model Petugas {
  id          String          @id @default(cuid())
  nama        String
  jabatan     String?
  noHp        String?
  kategori    KategoriPetugas @default(PROTOKOL)
  statusAktif Boolean         @default(true)
  createdAt   DateTime        @default(now())

  kegiatan KegiatanPetugas[]

  @@map("petugas")
}

model LeadingSector {
  id        String     @id @default(cuid())
  nama      String     @unique
  createdAt DateTime   @default(now())
  kegiatan  Kegiatan[]

  @@map("leading_sector")
}

model Kegiatan {
  id              String            @id @default(cuid())
  namaKegiatan    String
  tanggal         DateTime
  waktu           String?
  tempat          String
  pejabat         String
  leadingSectorId String
  leadingSector   LeadingSector     @relation(fields: [leadingSectorId], references: [id])
  statusSambutan  StatusSambutan    @default(BELUM)
  statusKegiatan  StatusKegiatan    @default(ACARA_MASUK)
  statusPublikasi StatusPublikasi   @default(BELUM_DIRILIS)
  jenisPenugasan  JenisPenugasan    @default(LEMBUR)
  linkUpload      String?
  catatan         String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  dokumen         Dokumen[]
  petugas         KegiatanPetugas[]

  @@map("kegiatan")
}

model KegiatanPetugas {
  kegiatanId String
  kegiatan   Kegiatan @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)
  petugasId  String
  petugas    Petugas  @relation(fields: [petugasId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([kegiatanId, petugasId])
  @@index([petugasId])
  @@map("kegiatan_petugas")
}

model Dokumen {
  id         String        @id @default(cuid())
  kegiatanId String
  kegiatan   Kegiatan      @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)
  jenis      JenisDokumen
  status     StatusDokumen @default(BELUM_UPLOAD)
  link       String?
  catatan    String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([kegiatanId, jenis])
  @@map("dokumen")
}

model ActivityLog {
  id        String    @id @default(cuid())
  entity    Entity
  entityId  String
  action    ActionLog
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  changes   Json?
  createdAt DateTime  @default(now())

  @@index([entity])
  @@index([entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("activity_log")
}
