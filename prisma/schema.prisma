generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  ATASAN
}

enum StatusSambutan {
  SUDAH
  BELUM
}

enum StatusKegiatan {
  DRAFT
  MENUNGGU_PERSETUJUAN
  DISETUJUI
  DILAKSANAKAN
  MENUNGGU_DOKUMEN
  SPJ_DIPROSES
  SPJ_SELESAI
}

enum JenisDokumen {
  SURAT_TUGAS
  SURAT_UNDANGAN
  NASKAH_SAMBUTAN
  DOKUMENTASi_FOTO
  DOKUMENTASi_VIDEO
  BERKAS_SPJ
  LAPORAN_AKHIR
}

enum StatusDokumen {
  BELUM_UPLOAD
  SUDAH_UPLOAD
  PERLU_REVISI
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  nama      String
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())

  @@map("users")
}

model Petugas {
  id          String   @id @default(cuid())
  nama        String
  jabatan     String?
  noHp        String?
  statusAktif Boolean  @default(true)
  createdAt   DateTime @default(now())

  kegiatanProtokol Kegiatan[] @relation("PetugasProtokolRelation")
  kegiatanLiputan  Kegiatan[] @relation("PetugasLiputanRelation")

  @@map("petugas")
}

model LeadingSector {
  id        String     @id @default(cuid())
  nama      String     @unique
  createdAt DateTime   @default(now())
  kegiatan  Kegiatan[]

  @@map("leading_sector")
}

model Kegiatan {
  id                String         @id @default(cuid())
  namaKegiatan      String
  tanggal           DateTime
  waktu             String?
  tempat            String
  pejabat           String
  leadingSectorId   String
  leadingSector     LeadingSector  @relation(fields: [leadingSectorId], references: [id])
  statusSambutan    StatusSambutan @default(BELUM)
  statusKegiatan    StatusKegiatan @default(DRAFT)
  petugasProtokolId String?
  petugasProtokol   Petugas?       @relation("PetugasProtokolRelation", fields: [petugasProtokolId], references: [id])
  petugasLiputanId  String?
  petugasLiputan    Petugas?       @relation("PetugasLiputanRelation", fields: [petugasLiputanId], references: [id])
  linkUpload        String?
  catatan           String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("kegiatan")
}

model Dokumen {
  id          String        @id @default(cuid())
  kegiatanId  String
  kegiatan    Kegiatan      @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)
  jenis       JenisDokumen
  status      StatusDokumen @default(BELUM_UPLOAD)
  link        String?
  catatan     String?
  updatedAt   DateTime      @updatedAt

  @@unique([kegiatanId, jenis])
  @@map("dokumen")
}